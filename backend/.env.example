# Copy to .env and adjust. All values are optional - defaults work for local development.

# Comma-separated list of allowed browser origins (the frontend URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional regex for extra origins, e.g. Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://ipl-insight-.*\.vercel\.app

# Folder holding the three .pkl files (default: backend/saved_models)
# MODELS_DIR=saved_models

# Path to the Cricsheet ball-by-ball CSV (default: backend/data/ball_by_ball_dataset.csv)
# DATASET_PATH=data/ball_by_ball_dataset.csv

LOG_LEVEL=INFO
